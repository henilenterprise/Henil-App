# Dependencies
node_modules/

# Build output
dist/
build/

# Environment variables — never commit real secrets.
# .env.example files ARE meant to be committed (they contain no
# secrets, only variable names) — this pattern matches exactly
# ".env"/".env.local" and does not affect ".env.example".
.env
.env.local
.env.*.local

# Supabase CLI local state (if the Supabase CLI is ever used locally)
.supabase/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Test coverage output
coverage/
