# Copy this file to ".env" (same folder) and fill in your real values.
# Never commit the real ".env" file — it's already in .gitignore.
#
# SECURITY: SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security
# entirely. It must only ever live here (server-side) — never in
# frontend/, never prefixed with VITE_, never sent to the browser.

# ---- Server ----
PORT=5000
CORS_ORIGIN=http://localhost:5173

# ---- Supabase ----
# Where to find these: Supabase Dashboard -> your project ->
# Project Settings -> API.
#   SUPABASE_URL              = "Project URL"
#   SUPABASE_SERVICE_ROLE_KEY = "Project API keys" -> "service_role"
#                                (click "Reveal" — keep this secret)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
