# Copy this file to ".env" (same folder) and fill in your real values.
# Never commit the real ".env" file — it's already in .gitignore.
#
# Vite only exposes variables prefixed with VITE_ to browser code, so
# every variable here must use that prefix.
#
# SECURITY: only ever put the Supabase "anon" / "public" key here.
# That key is safe to ship to the browser by design — real protection
# comes from the Row Level Security policies in database/migrations.
# NEVER put the "service_role" key in this file or anywhere in
# frontend/ — that key bypasses RLS entirely and must stay
# server-side only (see backend/.env.example).

# ---- Supabase ----
# Where to find these: Supabase Dashboard -> your project ->
# Project Settings -> API.
#   VITE_SUPABASE_URL      = "Project URL"
#   VITE_SUPABASE_ANON_KEY = "Project API keys" -> "anon" / "public"
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- Backend API ----
# Base URL of the Express backend (see backend/.env.example for its port).
VITE_API_BASE_URL=http://localhost:5000
